<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp">

    <!-- 活动名称+地点+组织部门 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:text="活动名称"
            android:textSize="18sp"
            android:layout_marginLeft="8dp"/>

        <TextView
            android:id="@+id/tv_location"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="活动地点"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tv_dept"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="组织部门"
            android:textSize="12sp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"/>

    </LinearLayout>

    <!-- 活动介绍 -->
    <TextView
        android:id="@+id/tv_intro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="活动介绍（最多三十个字）"
        android:textSize="12sp"
        android:layout_marginTop="6dp"
        android:layout_marginLeft="8dp"/>

    <!-- 活动时间 -->
    <TextView
        android:id="@+id/tv_activity_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="活动时间：2026.1.1 - 2026.1.2"
        android:textSize="12sp"
        android:layout_marginTop="6dp"
        android:layout_marginLeft="8dp"/>

    <!-- 报名时间+活动状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_apply_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="报名时间：2025.1.1 - 2025.1.2"
            android:textSize="12sp"
            android:layout_marginTop="6dp"
            android:layout_marginLeft="8dp"/>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:background="@color/green"
            android:text="发布中"
            android:textSize="18sp"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>

    <!-- 功能按钮：删除活动 + 查看报名详情 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btn_delete_activity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="删除活动"
            android:textSize="12sp"
            android:backgroundTint="#FF4444"
            android:textColor="@android:color/white"/>

        <Button
            android:id="@+id/btn_check_apply_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="查看报名详情"
            android:textSize="12sp"
            android:backgroundTint="@color/skyBlue"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>

</LinearLayout>