<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 顶部返回栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_gravity="left"
            android:src="@drawable/back"
            android:backgroundTint="@color/white"
            android:padding="8dp"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="发布活动"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- 滚动容器（适配多内容） -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 活动名称 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="活动名称："
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>
            <EditText
                android:id="@+id/et_activity_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入活动名称（如：校园歌手大赛）"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp"
                android:padding="8dp"
                android:background="@drawable/et_bg"
                android:maxLines="1"/>

            <!-- 活动地点 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="活动地点："
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/et_activity_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入活动地点（如：学校大礼堂）"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp"
                android:padding="8dp"
                android:background="@drawable/et_bg"
                android:maxLines="1"/>

            <!-- 组织部门 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="组织部门："
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/et_activity_dept"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入组织部门（如：学生会文艺部）"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp"
                android:padding="8dp"
                android:background="@drawable/et_bg"
                android:maxLines="1"/>

            <!-- 活动介绍 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="活动介绍："
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/et_activity_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入活动介绍（最多10行）"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp"
                android:padding="8dp"
                android:background="@drawable/et_bg"
                android:maxLines="10"
                android:gravity="start|top"/>

            <!-- 活动时间（日期范围） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="活动时间："
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textStyle="bold"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_activity_time_start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="请选择开始时间"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:padding="8dp"
                    android:background="@drawable/et_bg"
                    android:clickable="true"
                    android:focusable="true"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" - "
                    android:textSize="16sp"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center"/>
                <TextView
                    android:id="@+id/tv_activity_time_end"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="请选择结束时间"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:padding="8dp"
                    android:background="@drawable/et_bg"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- 报名截止时间（日期+时分） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="报名截止时间："
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>
            <TextView
                android:id="@+id/tv_apply_deadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请选择截止时间（含时分）"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginBottom="20dp"
                android:padding="8dp"
                android:background="@drawable/et_bg"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </ScrollView>

    <!-- 提交按钮 -->
    <Button
        android:id="@+id/btn_submit_activity"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="@color/green"
        android:text="提交发布"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:layout_marginTop="16dp"/>

</LinearLayout>