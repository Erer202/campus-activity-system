<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 第1层：主体背景（白色，可改成透明@android:color/transparent） -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" /> <!-- 背景色，适配大多数场景 -->
        </shape>
    </item>

    <!-- 第2层：顶部分隔线（#999999，高度1dp） -->
    <item
        android:height="1dp"
    android:gravity="top">
    <shape android:shape="rectangle">
        <solid android:color="#999999" />
    </shape>
</item>

    <!-- 第3层：底部分隔线（#999999，高度1dp） -->
<item
android:height="1dp"
android:gravity="bottom"> <!-- 定位到底部 -->
<shape android:shape="rectangle">
    <solid android:color="#999999" />
</shape>
</item>
    </layer-list>